{"actions":[{"id":"import_shared_url","label":"Import shared URL","path":"/api/context/import/start","method":"POST","configured":true,"enabled":false,"status":"disabled","actionRequired":"Implement URL evidence checks, document fetch adapters, cache storage, and user confirmation before enabling context import.","note":"Imports Google Docs, Notion, Gist, or other shared document URLs into a cacheable context record."},{"id":"save_edit","label":"Save context edit","path":"/api/context/edit/save","method":"POST","configured":true,"enabled":true,"status":"ready","actionRequired":"Sign in with an account, edit the native context document, and save it without wallet unlock.","note":"Saves native context edits without inking a PFTL transaction by default."},{"id":"fetch_history_cid","label":"Fetch historical CID","path":"/api/context/history/ipfs/:cid","method":"GET","configured":true,"enabled":true,"status":"ready","actionRequired":"Unlock the local seed vault in the browser before decrypting fetched CID content.","note":"Fetches encrypted JSON only for CIDs already present in the signed-in account's cached PFTL context projection."},{"id":"ink_manifest","label":"Ink PFTL manifest","path":"/api/context/manifest/ink","method":"POST","configured":true,"enabled":true,"status":"ready","actionRequired":"Unlock the local seed vault in the browser. The seed never leaves the device; the server only receives the encrypted payload and signed transaction blob.","note":"Encrypts the native context document, pins it to IPFS, and signs a portable pf.ptr/v4 CONTEXT pointer from the unlocked wallet."}]}