{"actions":[{"id":"top_up_start","label":"Top up with ETH, USDC, or USDT","path":"/api/usage/top-up/start","method":"POST","configured":true,"enabled":true,"status":"ready","actionRequired":"Use /api/usage/top-up/start to allocate the account deposit address.","note":"Allocates one account-scoped Ethereum mainnet deposit address. This is a custodial top-up rail, not a wallet-connect flow."},{"id":"top_up_sync","label":"Refresh Ethereum deposits","path":"/api/usage/top-up/sync","method":"POST","configured":true,"enabled":true,"status":"ready","actionRequired":"Use /api/usage/top-up/start to allocate the account deposit address.","note":"Reads the account deposit address on Ethereum mainnet, credits configured ETH, USDC, and USDT balance increases, and sends the one-time PFT grant after a qualifying USDC top-up for a newly created linked wallet."},{"id":"admin_credit","label":"Admin credit","path":"/api/usage/credit/admin","method":"POST","configured":false,"enabled":false,"status":"missing_config","actionRequired":"Configure TASKNODE_ADMIN_CREDIT_TOKEN","note":"Operator-only bootstrap path for crediting account balances while real crypto top-up rails are not implemented."}]}