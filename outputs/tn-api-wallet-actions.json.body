{"actions":[{"id":"create_start","label":"Create seed wallet","path":"/api/wallet/create/start","method":"POST","configured":true,"enabled":true,"status":"ready","actionRequired":"OAuth accounts can receive the grant after the encrypted local seed vault is saved. Email accounts can qualify after creating a wallet, saving the vault, and crediting more than $10 USDC.","note":"Generates a new 24-word seed wallet in the browser, links it by proof, saves the local vault, and then attempts the one-time initiation grant."},{"id":"link_start","label":"Link seed wallet","path":"/api/wallet/link/start","method":"POST","configured":true,"enabled":true,"status":"ready","actionRequired":"Enter a 24-word recovery phrase locally, derive the XRPL address in the browser, and sign the server challenge.","note":"Starts a browser-only seed wallet proof. The seed phrase never leaves the device."},{"id":"unlock_start","label":"Unlock wallet action","path":"/api/wallet/unlock/start","method":"POST","configured":true,"enabled":false,"status":"disabled","actionRequired":"Implement unlock transaction boundaries and signing confirmation screens before enabling wallet unlock.","note":"Unlocks only wallet-bound actions such as sending PFT, signing verifications, or inking context manifests."},{"id":"send_pft","label":"Send PFT","path":"/api/wallet/send/prepare","method":"POST","configured":true,"enabled":true,"status":"ready","actionRequired":"Unlock the matching local seed vault, enter a destination and amount, review the payment, then sign locally.","note":"Prepares a native PFTL Payment for the linked wallet. The browser signs locally and submits the signed blob to /api/wallet/send/submit."},{"id":"delink","label":"Delink wallet","path":"/api/wallet/delink","method":"POST","configured":true,"enabled":true,"status":"ready","actionRequired":"Confirm delink in the wallet tab. The browser should also clear the local encrypted vault.","note":"Detaches the active wallet from this app account without touching chain history or server-side audit history."},{"id":"relink_start","label":"Relink wallet","path":"/api/wallet/relink/start","method":"POST","configured":true,"enabled":true,"status":"ready","actionRequired":"Enter the recovery phrase locally and sign a fresh relink challenge.","note":"Starts a fresh wallet ownership proof for linking a wallet after delink or replacing the current proof."},{"id":"initiation_retry","label":"Retry initiation gift","path":"/api/wallet/initiation/retry","method":"POST","configured":true,"enabled":true,"status":"ready","actionRequired":"Requires a signed-in account, a linked wallet, a confirmed local seed vault, and configured PFTL faucet credentials.","note":"Retries the one-time PFT initiation gift for a linked wallet only after the matching local seed vault is confirmed in the browser."}]}